# 主服务
APP_HOST=127.0.0.1
APP_PORT=8000

# 独立 mock API，供后续 Agent 工具通过 HTTP 调用
MOCK_API_HOST=127.0.0.1
MOCK_API_PORT=8001
MOCK_API_BASE_URL=http://127.0.0.1:8001

# 本地服务日志级别：DEBUG / INFO / WARNING / ERROR
XIAOSU_LOG_LEVEL=INFO

# Chat 模型与飞书配置；Embedding 配置见下方。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Embedding 模型（为空时沿用 LLM_BASE_URL / LLM_API_KEY）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# 阿里百炼兼容模式示例：
# EMBEDDING_BASE_URL=https://<workspace>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=qwen3.7-text-embedding

FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书长连接可选调优；未配置 App ID/Secret 时保持停用，不影响 Web 管理后台启动。
FEISHU_CONNECT_TIMEOUT_SECONDS=10
FEISHU_SEND_MAX_ATTEMPTS=3
FEISHU_SEND_BACKOFF_SECONDS=0.5
FEISHU_DEDUP_TTL_SECONDS=43200
FEISHU_DEDUP_MAX_ENTRIES=5000
